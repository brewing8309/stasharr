{
  "manifest_version": 2,
  "name": "stasharr",
  "version": "1.3.0",
  "description": "send scenes from StashDB to Prowlarr",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["*://stashdb.org/*"],
      "js": ["common.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "stasharr",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{1d52423d-161b-4351-834a-d2ba8b3747f8}",
      "update_url": "https://raw.githubusercontent.com/brewing8309/stasharr/main/updates.json",
	  "data_collection_permissions": {
		"required": ["none"]
	  }
    }
  }
}
